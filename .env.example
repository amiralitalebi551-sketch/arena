# FarBoo — environment variables
# The landing page runs with NO env vars. These are only needed if you wire
# the FinalCTA form to a real backend / CRM. Never commit real secrets.

# Public site URL used for canonical + OG + sitemap (optional override).
NEXT_PUBLIC_SITE_URL=https://farboo.ai

# Example: endpoint your form route posts to (server-side only).
# LEAD_WEBHOOK_URL=
