{
  "log": {
    "loglevel": "warning",
    "access": "/dev/null",
    "error": "/dev/stderr"
  },
  "dns": {
    "servers": [
      "localhost",
      {
        "address": "https://1.1.1.1/dns-query",
        "port": 443,
        "concurrency": true
      },
      {
        "address": "https://8.8.8.8/dns-query",
        "port": 443,
        "concurrency": true
      }
    ],
    "queryStrategy": "UseIPv4",
    "disableFallbackIfMatch": true
