  "inbounds": [
    {
      "tag": "vless-ws-in",
      "listen": "127.0.0.1",
      "port": 2087,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "bac2db35-df5b-47e1-a8e1-19ecd81c1ed5",
            "level": 0,
            "email": "me@arena"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/cf5d72f32b82",
          "acceptProxyProtocol": false,
          "headers": {}
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
